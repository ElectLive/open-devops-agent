# Central open-source agent (one deployment)
AGENT_BASE_URL=https://agent.yourcompany.com
AGENT_FORWARD_PATH=/webhook/manual
# Must match the central agent's WEBHOOK_SECRET (HMAC signing)
AGENT_WEBHOOK_SECRET=change-me-to-random-string

# This middleware
ORG_ID=acme-corp
# Optional default SSH/host label attached to forwarded incidents
MIDDLEWARE_DEFAULT_HOST=ubuntu@10.0.1.50
# Protect /forward and /exec (Bearer or X-Middleware-Token)
MIDDLEWARE_AUTH_TOKEN=change-me-middleware-token
# Fail-closed auth default: set to true to allow unauthenticated /forward
# MIDDLEWARE_ALLOW_UNAUTHENTICATED=false
# Only trust caller X-Org-ID if explicitly enabled (or comma-separated allowlist)
# MIDDLEWARE_TRUST_CALLER_ORG_ID=false

# Optional: let the central agent call back for local commands
MIDDLEWARE_EXEC_ENABLED=false
MIDDLEWARE_EXEC_TIMEOUT=60
# Comma-separated regex allowlist (defaults include docker/nginx/kubectl get)
# MIDDLEWARE_EXEC_ALLOWLIST=^docker\s+(ps|logs|restart)\b,^df\s+-h$

HOST=0.0.0.0
PORT=8080
